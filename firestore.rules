rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'participantCount', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.participantCount is int
        && request.resource.data.participantCount > 0
        && request.resource.data.participantCount <= 200;
      allow update, delete: if false;

      match /participants/{ticketId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['name', 'usedAt', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.usedAt == null;
        allow update: if resource.data.usedAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedAt'])
          && request.resource.data.usedAt == request.time;
        allow delete: if false;
      }
    }
  }
}
